{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gond",
  "version": "0.1.0",
  "identifier": "io.gond.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "createUpdaterArtifacts": true,
    "category": "SocialNetworking",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/dawsja/gond/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFMkQ3M0FGQTY5MkYwMUYKUldRZjhKS21yM010ZmpoMmxaUTkyOGQ0Qjg2dzd2QzVYNnVKanB2di80T3AwVzQyTS9LTVp0dGUK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
