<?xml version="1.0" encoding="utf-8"?>
<!--
  A Gond on the local network is usually plain http (the README's quick
  start publishes port 3000 without TLS), so cleartext is allowed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
