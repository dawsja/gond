{
  "name": "gond-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.gond.io", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "PUSH", "class_name": "PushLimiter" },
      { "name": "USAGE", "class_name": "UsageTotals" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Mailbox"] },
    { "tag": "v2", "new_sqlite_classes": ["UsageTotals"] },
    { "tag": "v3", "deleted_classes": ["Mailbox"], "new_sqlite_classes": ["PushLimiter"] }
  ]
}
