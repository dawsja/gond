# The address you open Gond on, exactly as the browser shows it.
# On a server, this is your HTTPS address, e.g. https://gond.example.com
APP_URL=http://localhost:3000

# Recommended on a server. Encrypts the API keys and tokens Gond stores.
# Without it, Gond makes a key inside its data volume, next to what it
# encrypts, so anyone holding a copy of that volume can read them.
# Keep a copy of this value: lose it and stored keys must be entered again.
# Make one with: openssl rand -base64 32
# GOND_SECRET_KEY=
